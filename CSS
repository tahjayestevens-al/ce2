body {
  width: 340px;
  font-family: Arial, sans-serif;
  font-size: 13px;
  background-color: #f1f8e9;
  padding: 10px;
}

h1 {
  font-size: 18px;
  color: #2e7d32;
  text-align: center;
}

h2 {
  font-size: 15px;
  color: #2e7d32;
  border-bottom: 2px solid #a5d6a7;
}

label {
  display: block;
  margin-top: 6px;
  font-weight: bold;
}

input, select, textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 4px;
  margin-top: 2px;
}

button {
  margin-top: 8px;
  padding: 6px;
  width: 100%;
  background-color: #43a047;
  color: white;
  border: none;
  cursor: pointer;
}

button:hover {
  background-color: #2e7d32;
}

#message {
  color: #c62828;
  min-height: 16px;
}

.entry {
  background-color: white;
  border: 1px solid #a5d6a7;
  border-radius: 4px;
  padding: 6px;
  margin-top: 8px;
}

.entry .title {
  font-weight: bold;
  color: #2e7d32;
}

.entry .deleteBtn {
  background-color: #c62828;
  width: auto;
  padding: 3px 8px;
}

#deleteBtn {
  background-color: #c62828;
}
